# Copy to .env and fill in. Never commit .env.

# Client (optional). Dev proxies /api and /collab through Vite.
# VITE_COLLAB_URL=wss://collab.example.com

# Server
NODE_ENV=development
PORT=3001
COLLAB_PORT=1234
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://lazy:lazy@localhost:5432/lazy_builder
# generate with: openssl rand -base64 48
JWT_SECRET=wnm4ROhvO2Qg3DOYMVxd2BQWYRA1sun6qw3vNt4jDOSEoCo3OfGS709iaftakDt+
JWT_EXPIRES_IN_SECONDS=604800
    

# Public URL of the app (OAuth redirects come back here). Defaults to CLIENT_ORIGIN.
# APP_URL=http://localhost:5173

# Google sign-in (optional). Create an OAuth client (Web application) in Google Cloud Console
# and add this redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
